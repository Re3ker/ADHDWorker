generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id                    Int      @id @default(1)
  startTime             String   @default("08:45")
  pauseTime             String   @default("12:00")
  pauseMinutes          Int      @default(30)
  targetWorkMinutes     Int      @default(480)
  leadMinutes           Int      @default(1)
  launchAtLogin         Boolean  @default(false)
  sendStartImmediately  Boolean  @default(true)
  sendPauseImmediately  Boolean  @default(false)
  sendResumeImmediately Boolean  @default(false)
  sendEndImmediately    Boolean  @default(false)
  telegramChatId        String   @default("")
  telegramBotToken      String   @default("")
  minimizeOnClose       Boolean  @default(true)
  desktopNotifications  Boolean  @default(false)
  startMessageTemplate  String
  pauseMessageTemplate  String
  resumeMessageTemplate String
  endMessageTemplate    String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Workday {
  id               String            @id @default(cuid())
  status           String            @default("planned")
  scheduledStartAt DateTime?
  actualStartAt    DateTime?
  endedAt          DateTime?
  activeKey        String?           @unique
  plannedPauseAt   DateTime?
  pauseMinutes     Int?
  pendingAction    String?
  pendingActionAt  DateTime?
  pendingMessage   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         WorkSession[]
  telegramMessages TelegramMessage[]

  @@index([status, scheduledStartAt])
  @@index([createdAt])
}

model WorkSession {
  id        String    @id @default(cuid())
  workdayId String
  type      String
  startedAt DateTime
  endedAt   DateTime?
  activeKey String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workday   Workday   @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workdayId, type, startedAt])
}

model Task {
  id            String      @id @default(cuid())
  workSessionId String
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  @@index([workSessionId, createdAt])
}

model TelegramMessage {
  id           String    @id @default(cuid())
  workdayId    String
  type         String
  content      String
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  errorMessage String?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workday      Workday   @relation(fields: [workdayId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([workdayId, type])
}
