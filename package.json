{
  "name": "adhdworker",
  "version": "0.2.1",
  "description": "Lokale Desktop-App, die an An- und Abmeldung, Pause und Feierabend erinnert.",
  "author": "ADHDWorker",
  "type": "module",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win --publish never",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init_adhdworker",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "icons": "tsx scripts/build-icons.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.16.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.adhdworker.app",
    "productName": "ADHDWorker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "public/**/*",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      },
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "prisma/migrations",
        "to": "migrations"
      },
      {
        "from": "public/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "public/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/.prisma/**",
      "**/node_modules/@prisma/client/**"
    ],
    "win": {
      "icon": "resources/icon/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ADHDWorker"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Re3ker",
        "repo": "ADHDWorker"
      }
    ]
  }
}
